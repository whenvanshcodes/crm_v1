generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  displayName String?
  phone       String?
  email       String?
  website     String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venues      Venue[]
}

model Venue {
  id               String             @id @default(cuid())
  businessId       String?
  business         Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  shortName        String?
  phone            String
  email            String?
  address          String?
  city             String?            @default("Indore")
  state            String?
  pincode          String?
  timezone         String             @default("Asia/Kolkata")
  openingTime      String             @default("10:00")
  closingTime      String             @default("02:00")
  currency         String             @default("INR")
  status           String             @default("ACTIVE")
  logoUrl          String?
  coverImageUrl    String?
  dashboardHeroUrl String?
  galleryImages    String?
  primaryColor     String?            @default("#10b981")
  secondaryColor   String?            @default("#0f172a")
  taxRate          Float              @default(0)
  ownerId          String?
  owner            User?              @relation("VenueOwner", fields: [ownerId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]             @relation("VenueStaff")
  customers        Customer[]
  categories       ResourceCategory[]
  resources        Resource[]
  pricingRules     PricingRule[]
  addOns           AddOn[]
  bookings         Booking[]
  sessions         Session[]
  transactions     Transaction[]
  payments         Payment[]
  maintenanceBlocks MaintenanceBlock[]
  waitlistEntries   WaitlistEntry[]
  auditLogs        AuditLog[]
}

model User {
  id              String        @id @default(cuid())
  venueId         String?
  venue           Venue?        @relation("VenueStaff", fields: [venueId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String        @unique
  passwordHash    String
  role            String
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBookings Booking[]     @relation("BookingCreator")
  createdSessions Session[]     @relation("SessionCreator")
  endedSessions   Session[]     @relation("SessionEnder")
  payments        Payment[]
  auditLogs       AuditLog[]
  authSessions    AuthSession[]
  ownedVenues     Venue[]       @relation("VenueOwner")

  @@index([venueId, role])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Customer {
  id            String    @id @default(cuid())
  venueId       String
  venue         Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  totalVisits   Int       @default(0)
  totalSpending Float     @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  sessions      Session[]
  waitlistEntries WaitlistEntry[]

  @@unique([venueId, phone])
}

model ResourceCategory {
  id           String        @id @default(cuid())
  venueId      String
  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  status       String        @default("ACTIVE")
  resources    Resource[]
  pricingRules PricingRule[]

  @@unique([venueId, name])
}

model Resource {
  id                String             @id @default(cuid())
  venueId           String
  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          ResourceCategory?  @relation(fields: [categoryId], references: [id])
  name              String
  description       String?
  imageUrl          String?
  status            String             @default("AVAILABLE")
  pricingRules      PricingRule[]
  bookings          Booking[]
  sessions          Session[]
  maintenanceBlocks MaintenanceBlock[]

  @@unique([venueId, name])
  @@index([venueId, status])
}

model PricingRule {
  id           String            @id @default(cuid())
  venueId      String
  venue        Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId   String?
  resource     Resource?         @relation(fields: [resourceId], references: [id])
  categoryId   String?
  category     ResourceCategory? @relation(fields: [categoryId], references: [id])
  unit         String
  rate         Float
  fixedMinutes Int?
  active       Boolean           @default(true)
  sessions     Session[]
}

model AddOn {
  id             String         @id @default(cuid())
  venueId        String
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  pricingType    String         @default("PER_HOUR") // PER_HOUR, PER_SESSION, PER_PERSON, FIXED_CHARGE
  price          Float
  active         Boolean        @default(true)
  categoryName   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessionAddOns  SessionAddOn[]
  bookingAddOns  BookingAddOn[]

  @@index([venueId, active])
}

model BookingAddOn {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  unitPrice   Float
  pricingType String
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

model SessionAddOn {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  unitPrice   Float
  pricingType String
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

model Booking {
  id                     String         @id @default(cuid())
  venueId                String
  venue                  Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId             String
  resource               Resource       @relation(fields: [resourceId], references: [id])
  customerId             String
  customer               Customer       @relation(fields: [customerId], references: [id])
  createdById            String?
  createdBy              User?          @relation("BookingCreator", fields: [createdById], references: [id])
  startTime              DateTime
  endTime                DateTime
  status                 String         @default("CONFIRMED")
  partySize              Int            @default(1)
  groupMembers           String?
  plannedStartAt         DateTime?
  plannedEndAt           DateTime?
  plannedDurationMinutes Int?
  priceEstimate          Float?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  sessions               Session[]
  addOns                 BookingAddOn[]

  @@index([venueId, resourceId, startTime, endTime])
}

model Session {
  id                     String         @id @default(cuid())
  venueId                String
  venue                  Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId             String
  resource               Resource       @relation(fields: [resourceId], references: [id])
  customerId             String
  customer               Customer       @relation(fields: [customerId], references: [id])
  bookingId              String?
  booking                Booking?       @relation(fields: [bookingId], references: [id])
  pricingRuleId          String
  pricingRule            PricingRule    @relation(fields: [pricingRuleId], references: [id])
  startedAt              DateTime       @default(now())
  expectedEndAt          DateTime?
  endedAt                DateTime?
  status                 String         @default("ACTIVE")
  partySize              Int            @default(1)
  groupMembers           String?
  plannedStartAt         DateTime?
  plannedEndAt           DateTime?
  plannedDurationMinutes Int?
  actualStartAt          DateTime?
  actualEndAt            DateTime?
  actualDurationMinutes  Int?
  bookedAmount           Float?
  actualAmount           Float?
  finalAmount            Float?
  completionStatus       String? // ENDED_EARLY, COMPLETED_AS_BOOKED, EXTENDED, RAN_OVER
  extensionHistory       String? // JSON string: [{ minutes, addedAt, newPlannedEnd }]
  createdById            String?
  createdBy              User?          @relation("SessionCreator", fields: [createdById], references: [id])
  endedById              String?
  endedBy                User?          @relation("SessionEnder", fields: [endedById], references: [id])
  transaction            Transaction?
  addOns                 SessionAddOn[]

  @@index([venueId, resourceId, status])
}

model Transaction {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessionId String    @unique
  session   Session   @relation(fields: [sessionId], references: [id])
  subtotal  Float
  discount  Float     @default(0)
  tax       Float     @default(0)
  total     Float
  createdAt DateTime  @default(now())
  payments  Payment[]
}

model Payment {
  id            String      @id @default(cuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  amount        Float
  method        String
  status        String      @default("PAID")
  recordedById  String?
  recordedBy    User?       @relation(fields: [recordedById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([venueId, createdAt])
}

model MaintenanceBlock {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  startTime  DateTime
  endTime    DateTime
  reason     String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  venueId   String?
  venue     Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  venueId       String
  venue         Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  partySize     Int       @default(1)
  categoryName  String?
  preferredTime String?
  notes         String?
  status        String    @default("WAITING") // WAITING, ASSIGNED, SKIPPED, REMOVED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([venueId, status])
}
